# Settings for deploy.sh. Copy this file to .env, change what you need, and run
#
#   ./deploy.sh --docker dd|ce|k3s|k8s --env .env --install
#   ./deploy.sh --env .env --uninstall          # keeps the data; add --purge to delete it
#
# Every line is optional: the value shown is the default. Lines are read as
# KEY=VALUE (the file isn't run as a script); # starts a comment, quotes are
# optional, and a variable already set in your environment wins.
# Keep .env out of git: it can hold the passphrase.

# ---- all targets ------------------------------------------------------------

# Where to deploy when --docker isn't given:
#   dd   Docker Desktop / Docker / Podman on this machine
#   ce   Docker CE (Docker Engine) on a Linux server: this one, or another one
#        over SSH (CE_HOST)
#   k3s  k3s
#   k8s  any Kubernetes cluster
DEPLOY_TARGET=dd

# Container / Deployment / Service name, and the image name.
CACTUSDB_NAME=cactusdb
CACTUSDB_IMAGE=cactusdb

# Port cactusdb listens on, and the port you open in the browser
# (Docker: http://<host>:8080; Kubernetes: the Service port).
CACTUSDB_PORT=8080

# Time zone for log times and export file names, e.g. Europe/Amsterdam.
# Empty: UTC.
CACTUSDB_TZ=

# Encrypt saved usernames and passwords with this passphrase instead of the
# key file cactus.key (stored as a Kubernetes Secret on k3s/k8s). If you set
# it, set the same passphrase on every install, or the saved connections
# can't be read.
CACTUSDB_PASSPHRASE=

# The superuser password: it opens every saved connection, also those
# protected by their own connection password. Used only on the first start,
# to set it when none exists; it never changes an existing one (change it with
# cactusdb --superuser set). At least 10 characters. Stored as a Kubernetes
# Secret on k3s/k8s. Leave empty to set it yourself instead.
CACTUSDB_SUPERUSER_PASSWORD=

# docker or podman, to build the image (and run it for dd). Empty: whichever
# is installed.
CONTAINER_RUNTIME=

# ---- dd: Docker / Docker Desktop / Podman ----------------------------------

# Host address the port is published on: 0.0.0.0 = every address (other
# computers can connect), 127.0.0.1 = this computer only.
DD_BIND=0.0.0.0

# Folders on this computer. DD_DATA_DIR holds export/ and conn/ unless you
# set them separately. conn/ gets cactus.conn.db and cactus.key.
DD_DATA_DIR=~/cactusdb
DD_EXPORT_DIR=
DD_CONN_DIR=

# Optional folder of SQLite databases, mounted read-only in the container at
# /sqlite: connect to /sqlite/<file>.
# Created (empty) if it doesn't exist yet; copy your .db files into it.
DD_SQLITE_DIR=

# ---- ce: Docker CE on a Linux server ---------------------------------------

# The server, as user@host (or ssh://user@host:port). Empty: Docker CE on this
# machine. Over SSH, every docker command runs on the server (DOCKER_HOST);
# you need SSH key access, the docker command here, and that user in the
# server's docker group.
CE_HOST=

# Install Docker CE on the server (or here) if it's missing, with Docker's
# script from https://get.docker.com, start it at boot and add the SSH user to
# the docker group. Linux only; needs sudo. yes or no.
CE_INSTALL_DOCKER=no

# Host address the port is published on (0.0.0.0 = every address).
CE_BIND=0.0.0.0

# Folders on the server (full paths). CE_DATA_DIR holds export/ and conn/
# unless you set them separately. They're created if missing.
CE_DATA_DIR=/srv/cactusdb
CE_EXPORT_DIR=
CE_CONN_DIR=

# Optional folder of SQLite databases on the server, mounted read-only at
# /sqlite: connect to /sqlite/<file>.
CE_SQLITE_DIR=

# uid:gid cactusdb runs as, and that owns the data folders. Empty: the SSH
# user on the server (or you, on this machine).
CE_RUN_AS=

# ---- k3s / k8s --------------------------------------------------------------

# Namespace (created if missing) and kubectl context (empty: the current one).
K8S_NAMESPACE=cactusdb
K8S_CONTEXT=

# kubectl command. Empty: kubectl, or "sudo k3s kubectl" on a k3s server
# without kubectl.
KUBECTL=

# How the web app is reached:
#   NodePort      http://<any node IP>:<node port> (default)
#   LoadBalancer  an external address (k3s has a built-in load balancer)
#   ClusterIP     inside the cluster only (put an Ingress in front, or use
#                 kubectl port-forward)
K8S_SERVICE_TYPE=NodePort
# Fixed node port (30000-32767). Empty: Kubernetes picks one.
K8S_NODE_PORT=

# Where the data lives:
#   pvc       PersistentVolumeClaims (default; uses the default StorageClass,
#             e.g. local-path on k3s)
#   hostpath  folders on the node (set K8S_NODE on a multi-node cluster)
K8S_STORAGE=pvc
K8S_STORAGE_CLASS=
K8S_CONN_SIZE=1Gi
K8S_EXPORT_SIZE=10Gi
K8S_HOSTPATH_CONN=/var/lib/cactusdb/conn
K8S_HOSTPATH_EXPORT=/var/lib/cactusdb/export

# Optional folder of SQLite databases on the node, mounted read-only at /sqlite.
K8S_HOSTPATH_SQLITE=

# Run cactusdb on this node only (its kubernetes.io/hostname). Needed for
# hostpath storage on a cluster with several nodes.
K8S_NODE=

# How the image gets to the cluster:
#   auto  push if K8S_REGISTRY is set; else import into k3s (k3s); else
#         nothing, for clusters that see this computer's images (Docker Desktop)
#   push  push to K8S_REGISTRY (needed for most k8s clusters)
#   k3s   import into k3s's containerd: on this machine, over SSH (K3S_SSH),
#         or with your own command (K3S_IMPORT)
#   none  the image is already there
K8S_IMAGE_LOAD=auto
# Registry to push to, e.g. registry.example.com/tools or ghcr.io/me. Log in
# first (docker login). With nodes of several architectures, the image is
# built for all of them with docker buildx.
K8S_REGISTRY=

# k3s on another machine: import the image there over SSH (user needs sudo).
K3S_SSH=
# Or any command that reads an image tar on stdin, e.g.
# K3S_IMPORT="ssh admin@k3s1 sudo k3s ctr images import -"
K3S_IMPORT=

# User and group cactusdb runs as in the pod.
K8S_RUN_AS_UID=1000
K8S_RUN_AS_GID=1000
